{
  "security_schemes": {
    "BearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT",
      "description": "JWT Bearer token authentication"
    },
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "description": "API Key authentication via header"
    }
  },
  "mandatory_body_fields": [
    {
      "name": "traceId",
      "schema": {
        "type": "string",
        "format": "uuid",
        "description": "Unique trace identifier"
      },
      "required": true,
      "apply_to": "both"
    },
    {
      "name": "timestamp",
      "schema": {
        "type": "string",
        "format": "date-time",
        "description": "Request/response timestamp"
      },
      "required": true,
      "apply_to": "both"
    }
  ],
  "openapi_extensions": {
    "x-company-metadata": {
      "team": "Platform Team",
      "cost-center": "Engineering"
    },
    "x-api-version": "2.1"
  },
  "naming_convention": "camelCase"
}

